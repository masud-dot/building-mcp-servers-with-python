# Copy to .env and adjust. Never commit .env.

# Connection string for the warehouse. Use a role that can
# read the allow-listed tables and write nothing.
DATAENG_DSN=postgresql://mcp_reader:localdev@127.0.0.1/warehouse

# Comma-separated tables this server may read. Anything not
# listed here is refused before any SQL runs.
DATAENG_TABLES=analytics.customers,analytics.orders,analytics.pipeline_runs

# Hard caps.
DATAENG_MAX_ROWS=200
DATAENG_STATEMENT_TIMEOUT_MS=5000
