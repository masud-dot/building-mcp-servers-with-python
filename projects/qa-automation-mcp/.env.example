# Copy to .env and adjust. Never commit .env.

# Test-management API. The token is a secret: it is held as
# SecretStr and never appears in logs or results.
QAOPS_BASE_URL=http://127.0.0.1:8931
QAOPS_TOKEN=CHANGE_ME

# Directory artefacts are served from. Every read is confined
# to this root.
QAOPS_ARTIFACT_ROOT=./artifacts

# Caps.
QAOPS_MAX_TRACE_CHARS=800
QAOPS_MAX_ARTIFACT_BYTES=65536
