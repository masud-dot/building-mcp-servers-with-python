# Copy to .env and adjust. Never commit .env.

# Read-only connection. Contains a password.
AIOPS_DSN=postgresql://aiops_reader:localdev@127.0.0.1/aiops
# Acknowledges incidents and stores scans. Nothing else.
AIOPS_WRITER_DSN=postgresql://aiops_writer:localdev@127.0.0.1/aiops

# Monitoring API.
AIOPS_MONITORING_URL=http://127.0.0.1:8955
AIOPS_MONITORING_TOKEN=CHANGE_ME

# Runbooks are served only from beneath this root.
AIOPS_RUNBOOK_ROOT=./runbooks

# Required for any HTTP deployment; the process refuses
# to start over HTTP without a verifier.
AIOPS_AUTH_ENABLED=false
AIOPS_AUTH_ISSUER=https://id.example
AIOPS_AUTH_AUDIENCE=https://mcp.example/mcp
AIOPS_AUTH_PUBLIC_KEY=
